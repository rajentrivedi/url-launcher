{
    "name": "rajen/nativephp-url-launcher",
    "version": "1.0.0",
    "description": "A NativePHP Mobile plugin for communicating with device functionalities",
    "namespace": "UrlLauncher",
    "keywords": [],
    "category": "utilities",
    "license": "MIT",
    "pricing": {
        "type": "free"
    },
    "author": {
        "name": "Rajen Trivedi",
        "email": "larave.rajen@gmail.com",
        "url": "https://github.com/rajen"
    },
    "homepage": "https://github.com/rajen/nativephp-url-launcher",
    "repository": "https://github.com/rajen/nativephp-url-launcher",
    "funding": [],
    "platforms": [
        "android",
        "ios"
    ],
    "icon": "resources/icon.png",
    "screenshots": [],
    "bridge_functions": [
        {
            "name": "UrlLauncher.Execute",
            "android": "com.nativephp.plugins.url_launcher.UrlLauncherFunctions.Execute",
            "ios": "UrlLauncherFunctions.Execute",
            "description": "Execute the plugin functionality"
        },
        {
            "name": "UrlLauncher.GetStatus",
            "android": "com.nativephp.plugins.url_launcher.UrlLauncherFunctions.GetStatus",
            "ios": "UrlLauncherFunctions.GetStatus",
            "description": "Get the current status"
        }
    ],
    "android": {
        "min_version": 21,
        "permissions": [],
        "repositories": [],
        "dependencies": {
            "implementation": []
        },
        "activities": [],
        "services": [],
        "receivers": [],
        "providers": []
    },
    "ios": {
        "min_version": "13.0",
        "info_plist": {
            "LSApplicationQueriesSchemes": [
                "whatsapp",
                "mailto",
                "tel",
                "sms",
                "comgooglemaps",
                "twitter"
            ]
        },
        "permissions": [],
        "repositories": [],
        "dependencies": {
            "swift_packages": [],
            "pods": []
        }
    },
    "assets": {
        "android": [],
        "ios": []
    },
    "secrets": [],
    "events": [
        "Rajen\\NativePhpUrlLauncher\\Events\\UrlLauncherCompleted"
    ],
    "service_provider": "Rajen\\NativePhpUrlLauncher\\UrlLauncherServiceProvider",
    "hooks": {
        "copy_assets": "nativephp:url-launcher:copy-assets"
    }
}