{
    "name": "rajen/nativephp-url-launcher",
    "description": "Native external URL and deep link launcher for NativePHP applications.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "url",
        "deep-link",
        "mobile",
        "android",
        "ios"
    ],
    "homepage": "https://github.com/rajen/nativephp-url-launcher",
    "authors": [
        {
            "name": "Rajen Trivedi",
            "email": "larave.rajen@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Rajen\\NativePhpUrlLauncher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rajen\\NativePhpUrlLauncher\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rajen\\NativePhpUrlLauncher\\UrlLauncherServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^10.9"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}